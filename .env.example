# Supabase Storage photo bucket. Create a PRIVATE bucket named mrd-group-photos.
# SUPABASE_URL may reuse NEXT_PUBLIC_SUPABASE_URL if that is already configured.
SUPABASE_URL=
# Use a Supabase secret key (sb_secret_...) on the server only. Never use NEXT_PUBLIC_ here.
SUPABASE_SECRET_KEY=
SUPABASE_PHOTO_BUCKET=mrd-group-photos

# Optional: serve pinned MediaPipe assets yourself instead of using the defaults.
# NEXT_PUBLIC_VISION_WASM_URL=/vision/wasm
# NEXT_PUBLIC_POSE_MODEL_URL=/vision/pose_landmarker_full.task
