# Server-only Cloudflare R2 credentials. Create a PRIVATE Standard bucket named mrd-group-photos.
# Create an R2 Object Read & Write token restricted to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PHOTO_BUCKET=mrd-group-photos

# Optional: serve pinned MediaPipe assets yourself instead of using the defaults.
# NEXT_PUBLIC_VISION_WASM_URL=/vision/wasm
# NEXT_PUBLIC_POSE_MODEL_URL=/vision/pose_landmarker_lite.task
