# Server-only Supabase credentials. Create a PRIVATE bucket named mrd-group-photos.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=mrd-group-photos

# Optional: serve pinned MediaPipe assets yourself instead of using the defaults.
# NEXT_PUBLIC_VISION_WASM_URL=/vision/wasm
# NEXT_PUBLIC_POSE_MODEL_URL=/vision/pose_landmarker_lite.task
